###
#  summary: List all keys as NDJSON
#  description: |
#    Router only. Fans out to each node's /internal/keys and streams the
#    union as newline-delimited JSON. Unreachable nodes are skipped.
#    A node process returns 501.
#  tags:
#    - KV
#  produces:
#    - application/x-ndjson
#    - application/json
#  responses:
#    200:
#      description: NDJSON stream; each line is a KeyNode
#      schema:
#        $ref: '#/definitions/KeyNode'
#    501:
#      description: Listing is not available on a storage node
#      schema:
#        $ref: '#/definitions/ErrorResponse'
###
GET     /kv                 controllers.KvDispatcher.listAll()

###
